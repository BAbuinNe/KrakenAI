FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY requirements-e5.txt requirements.txt ./
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch && pip install --no-cache-dir -r requirements-e5.txt
COPY app ./app
RUN useradd --create-home kraken
USER kraken
EXPOSE 8000
CMD ["uvicorn","app.e5_server:app","--host","0.0.0.0","--port","8000","--workers","1"]
