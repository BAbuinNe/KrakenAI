APP_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD_OF_32_CHARS
APP_ENV=development
# PUBLIC_ORIGIN=https://kraken.example.ru
# AI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=your-model-name
# AI_API_KEY=your-server-side-key

# Local/offline AI — see compose.local.yml and docs/LOCAL_AI.md
# AI_BACKEND=ollama
# AI_MODEL=qwen2.5:7b-instruct
# OLLAMA_URL=http://ollama:11434/api/chat

# KrakenAI on Google Gemini (server-only; never put the key in a client bundle).
# AI_BACKEND=gemini
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=SET_IN_SERVER_SECRET_MANAGER_NOT_IN_GIT
